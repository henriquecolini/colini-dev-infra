# Copy to terraform.tfvars (gitignored) and fill in real values.
# terraform.tfvars is never committed — only this .example file is.

region         = "sa-saopaulo-1"
tenancy_ocid   = "ocid1.tenancy.oc1..xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
admin_cidr     = "203.0.113.4/32" # your own public IP as a /32, not 0.0.0.0/0
ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... you@yourmachine"
